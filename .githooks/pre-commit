#!/usr/bin/env bash
# Gate anti-drift de la arquitectura-as-code (CK-17).
# Activación (una vez por clone):  git config core.hooksPath .githooks
#
# Qué hace en cada commit:
#   1. Corre gen_arquitectura.py — valida NODOS.md + arquitectura.yaml + despliegue.html
#      (cobertura de nodos y madurez del diagrama curado) y REGENERA los derivados
#      (nodos.data.js, arquitectura.html).
#   2. Si la validación falla → bloquea el commit (arregla la fuente o el diagrama).
#   3. Si los generados cambiaron → los agrega al commit automáticamente (mismo evento).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! python3 sistema/arquitectura/gen_arquitectura.py; then
  echo ""
  echo "✖ pre-commit: la arquitectura-as-code no valida — commit bloqueado."
  echo "  Corrige NODOS.md / arquitectura.yaml / despliegue.html y reintenta."
  exit 1
fi

git add sistema/arquitectura/nodos.data.js sistema/arquitectura/arquitectura.html
