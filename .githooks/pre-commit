#!/usr/bin/env bash
# Gates anti-drift del sistema as-code (CK-17 arquitectura · CK-19 metodología · CK-22 roadmap ·
# schema-v2 objeto/kinética). Activación (una vez por clone):  git config core.hooksPath .githooks
#
# Qué hace en cada commit:
#   1. arquitectura-as-code — gen_arquitectura.py valida NODOS.md + arquitectura.yaml +
#      despliegue.html y REGENERA los derivados (nodos.data.js, arquitectura.html).
#   2. metodología-as-code — gen_metodo.py valida methodologies.yaml (contra
#      methodology.schema.yaml v3: ciclo de vida estado/superseded) + el árbol proceso/
#      + nichos/*.yaml y REGENERA METODOLOGIA.md §4 + NOTACIONES.html + GRAFO.md.
#   3. roadmap (CK-22) — gen_roadmap.py valida story.yaml ↔ releases/*.yaml (biyección,
#      deps resuelven) y REGENERA ROADMAP.md § Estado.
#   4. objeto-schema (historia schema-v2) — gen_schema.py valida objeto.schema.yaml v2
#      (nodos/enums/relaciones/acciones/transiciones) + verbos.yaml (clase ALM×MGI completa).
#   5. mockup del twin — build.py concatena prototypes/twin-territorio-2026-07-20/src/ →
#      index.html (el Artifact exige un archivo self-contained) + node --check del JS.
#   6. Si cualquiera falla la validación → bloquea el commit (arregla la fuente).
#   7. Si un generado cambió → se agrega al commit automáticamente (mismo evento).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! python3 sistema/arquitectura/gen_arquitectura.py; then
  echo ""
  echo "✖ pre-commit: la arquitectura-as-code no valida — commit bloqueado."
  echo "  Corrige NODOS.md / arquitectura.yaml / despliegue.html y reintenta."
  exit 1
fi

if ! python3 sistema/metodo/gen_metodo.py; then
  echo ""
  echo "✖ pre-commit: la metodología-as-code no valida — commit bloqueado."
  echo "  Corrige methodologies.yaml / proceso/** y reintenta."
  exit 1
fi

if ! python3 docs/product/gen_roadmap.py; then
  echo ""
  echo "✖ pre-commit: el roadmap no valida — commit bloqueado."
  echo "  Corrige story.yaml / releases/*.yaml y reintenta."
  exit 1
fi

if ! python3 sistema/schema/gen_schema.py; then
  echo ""
  echo "✖ pre-commit: el objeto.schema/verbos no valida — commit bloqueado."
  echo "  Corrige sistema/schema/objeto.schema.yaml / verbos.yaml y reintenta."
  exit 1
fi

if ! python3 docs/product/prototypes/twin-territorio-2026-07-20/build.py; then
  echo ""
  echo "✖ pre-commit: el mockup del twin no construye — commit bloqueado."
  echo "  Corrige las partes en prototypes/twin-territorio-2026-07-20/src/ y reintenta."
  exit 1
fi

git add \
  sistema/arquitectura/nodos.data.js sistema/arquitectura/arquitectura.html \
  sistema/metodo/METODOLOGIA.md sistema/metodo/NOTACIONES.html sistema/metodo/GRAFO.md \
  docs/product/ROADMAP.md \
  docs/product/prototypes/twin-territorio-2026-07-20/index.html
